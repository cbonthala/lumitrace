meta {
  name: List tools
  type: http
  seq: 2
}

post {
  url: {{lensUrl}}/mcp
  body: json
  auth: bearer
}

headers {
  Accept: application/json, text/event-stream
  Content-Type: application/json
  Mcp-Session-Id: {{mcpSessionId}}
  MCP-Protocol-Version: {{mcpProtocolVersion}}
}

auth:bearer {
  token: {{mcpToken}}
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 2,
    "method": "tools/list"
  }
}

docs {
  The five tools with their descriptions and input schemas.
}
