meta {
  name: query_facts
  type: http
  seq: 5
}

post {
  url: {{lensUrl}}/mcp
  body: json
  auth: bearer
}

headers {
  Accept: application/json, text/event-stream
  Content-Type: application/json
  Mcp-Session-Id: {{mcpSessionId}}
  MCP-Protocol-Version: {{mcpProtocolVersion}}
}

auth:bearer {
  token: {{mcpToken}}
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 5,
    "method": "tools/call",
    "params": {
      "name": "query_facts",
      "arguments": {
        "kind": "meals",
        "contains": "taco",
        "limit": 20
      }
    }
  }
}

docs {
  `kind`: meals | activities | people | places | family | mood | highlights. Optional `contains`,
  `from_date`, `to_date`, `limit` (1-500) and `person` (family only).
}
