meta {
  name: get_day
  type: http
  seq: 4
}

post {
  url: {{lensUrl}}/mcp
  body: json
  auth: bearer
}

headers {
  Accept: application/json, text/event-stream
  Content-Type: application/json
  Mcp-Session-Id: {{mcpSessionId}}
  MCP-Protocol-Version: {{mcpProtocolVersion}}
}

auth:bearer {
  token: {{mcpToken}}
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 4,
    "method": "tools/call",
    "params": {
      "name": "get_day",
      "arguments": {
        "date": "2026-10-12"
      }
    }
  }
}

docs {
  The full entry for one day (`date`: YYYY-MM-DD).
}
