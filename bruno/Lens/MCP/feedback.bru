meta {
  name: feedback
  type: http
  seq: 7
}

post {
  url: {{lensUrl}}/mcp
  body: json
  auth: bearer
}

headers {
  Accept: application/json, text/event-stream
  Content-Type: application/json
  Mcp-Session-Id: {{mcpSessionId}}
  MCP-Protocol-Version: {{mcpProtocolVersion}}
}

auth:bearer {
  token: {{mcpToken}}
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 7,
    "method": "tools/call",
    "params": {
      "name": "feedback",
      "arguments": {
        "question": "Test from Bruno: what did I eat for lunch?",
        "answer": "Tacos, on 2026-10-12.",
        "comment": "Test feedback sent from Bruno; ignore.",
        "rating": "other"
      }
    }
  }
}

docs {
  Writes a feedback record (in production: a real one under `_system/feedback/`).
  `rating`: wrong | incomplete | good | other. Optional `dates` and `tool`.
}
