meta {
  name: Quick note (JSON)
  type: http
  seq: 2
}

post {
  url: {{prismUrl}}/notes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiToken}}
}

body:json {
  {
    "text": "Test note from Bruno: walked to the park and had tacos for lunch.",
    "place": "Austin"
  }
}

script:post-response {
  if (res.body && res.body.capture_id) {
    bru.setVar("captureId", res.body.capture_id);
  }
}

docs {
  Text-only Quick Note. Optional fields: `captured_at` (ISO-8601, default now), `lat`, `lon`,
  `place`, `capture_id` (resending the same id is answered `200` with `duplicate: true`).
}
