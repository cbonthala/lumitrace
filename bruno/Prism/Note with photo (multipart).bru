meta {
  name: Note with photo (multipart)
  type: http
  seq: 3
}

post {
  url: {{prismUrl}}/notes
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{apiToken}}
}

body:multipart-form {
  text: Test note from Bruno with a photo.
  place: Austin
  photos: @file(samples/photo.jpg)
}

script:post-response {
  if (res.body && res.body.capture_id) {
    bru.setVar("captureId", res.body.capture_id);
  }
}

docs {
  Quick Note with text and photos (`photos`, `photos[]` or `photo`; up to 60). A note may also
  carry a short `audio` clip instead of text.
}
