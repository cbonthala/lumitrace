meta {
  name: Capture status
  type: http
  seq: 5
}

get {
  url: {{prismUrl}}/captures/{{captureId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{apiToken}}
}

docs {
  Status of the last capture sent from this collection: `queued`, `processing`, `done` or
  `failed` (with the error and the next retry time).
}
