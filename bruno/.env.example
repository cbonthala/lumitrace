# Values for the Bruno environments. Copy to bruno/.env (git-ignored) and fill in.
# Tokens are the same values as in the server's .env (LUMITRACE_API_TOKEN and
# LUMITRACE_MCP_AUTH_TOKEN).

# Local: `uv run lumitrace-prism`, `lumitrace-spectrum run`, `lumitrace-lens` or docker compose.
LOCAL_API_TOKEN=
LOCAL_MCP_TOKEN=

# Production: your Tailscale name, e.g. https://lumitrace.<tailnet>.ts.net
PROD_PRISM_URL=https://lumitrace.example.ts.net:8443
PROD_LENS_URL=https://lumitrace.example.ts.net
PROD_API_TOKEN=
PROD_MCP_TOKEN=
