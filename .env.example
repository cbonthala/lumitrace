# LifeLog configuration. Copy to `.env` (never commit `.env`) and fill in.
# Every LifeLog variable is prefixed LIFELOG_ and maps to a field in lifelog/config.py.
# tests/test_config.py fails if a setting is missing here.

# --- General -------------------------------------------------------------------------------
LIFELOG_LOG_LEVEL=INFO
# IANA timezone used for entry dates and capture times.
LIFELOG_TIMEZONE=America/Chicago
# Captures before this local hour count as the previous day (0-23).
LIFELOG_DAY_ROLLOVER_HOUR=4
# Folder holding the versioned AI prompts.
LIFELOG_PROMPTS_DIR=prompts

# --- Recording API -------------------------------------------------------------------------
# Bearer token the iPhone Shortcuts send. Generate with: openssl rand -hex 32
# REPLACE before `docker compose up`: while the token is empty, `change-me` or shorter than 16
# characters, the API answers every request (except /health) with 503.
LIFELOG_API_TOKEN=change-me
LIFELOG_API_HOST=0.0.0.0
LIFELOG_API_PORT=8000
LIFELOG_API_MAX_UPLOAD_MB=200
# Compressed voice-note bitrate (AAC in .m4a). 32 kbps is about 1.5 MB for 6 minutes.
LIFELOG_AUDIO_BITRATE_KBPS=32
# Longest side of the resized photo copies, and JPEG quality (1-95).
LIFELOG_PHOTO_MAX_DIMENSION=2048
LIFELOG_PHOTO_JPEG_QUALITY=85

# --- Storage -------------------------------------------------------------------------------
# local | gdrive
LIFELOG_STORAGE_BACKEND=local
# Local backend: this folder plays the role of the Drive "LifeLog" folder.
LIFELOG_LOCAL_ROOT=data/LifeLog
# Google Drive backend: OAuth client (Desktop app) JSON from Google Cloud Console, and the token
# file written by `lifelog-gdrive-login`. Keep both out of git (secrets/ is ignored).
LIFELOG_GDRIVE_CLIENT_SECRETS_FILE=secrets/gdrive_client_secret.json
LIFELOG_GDRIVE_TOKEN_FILE=secrets/gdrive_token.json
# Name of the root folder the app creates in My Drive.
LIFELOG_GDRIVE_ROOT_FOLDER=LifeLog

# --- Speech to text ------------------------------------------------------------------------
# litellm (OpenAI, Azure, Groq, ... via LiteLLM) | aws_transcribe | fake (offline tests)
LIFELOG_STT_PROVIDER=litellm
LIFELOG_STT_MODEL=openai/gpt-4o-transcribe
LIFELOG_STT_LANGUAGE=en
# Amazon Transcribe needs a region and an S3 bucket for the upload.
LIFELOG_AWS_REGION=us-east-1
LIFELOG_AWS_TRANSCRIBE_BUCKET=

# --- AI models (LiteLLM model strings, e.g. bedrock/..., openai/..., ollama/...) ------------
# Offline trial without any provider: set all three to `fake` (facts stay empty, the journal is
# the day's text) together with LIFELOG_STT_PROVIDER=fake and LIFELOG_EMBEDDING_MODEL=fake.
LIFELOG_LLM_EXTRACT_FACTS_MODEL=openai/gpt-4o-mini
LIFELOG_LLM_WRITE_JOURNAL_MODEL=openai/gpt-4o
# Used when the task model fails.
LIFELOG_LLM_FALLBACK_MODEL=openai/gpt-4o-mini
LIFELOG_LLM_TIMEOUT_SECONDS=120
LIFELOG_LLM_MAX_RETRIES=2

# --- Embeddings ------------------------------------------------------------------------------
# LiteLLM embedding model, or "fake" for deterministic offline vectors.
# Changing the model or dimension requires `lifelog-indexer rebuild`.
LIFELOG_EMBEDDING_MODEL=openai/text-embedding-3-small
LIFELOG_EMBEDDING_DIMENSION=1536

# --- Index / indexer ---------------------------------------------------------------------------
LIFELOG_INDEX_PATH=data/index/lifelog.sqlite
LIFELOG_INDEXER_HOST=0.0.0.0
LIFELOG_INDEXER_PORT=8001
LIFELOG_INDEXER_POLL_INTERVAL_SECONDS=300
# Where the recording API POSTs after each write (in Docker: http://indexer:8001/nudge).
LIFELOG_INDEXER_NUDGE_URL=http://localhost:8001/nudge
# How often the index is copied to Drive (_system/index-backup/). 0 disables.
LIFELOG_INDEXER_BACKUP_INTERVAL_HOURS=24

# --- MCP server --------------------------------------------------------------------------------
# stdio (local AI apps) | streamable-http (remote / phone AI apps)
LIFELOG_MCP_TRANSPORT=streamable-http
LIFELOG_MCP_HOST=0.0.0.0
LIFELOG_MCP_PORT=8002
LIFELOG_MCP_PATH=/mcp
# Public HTTPS URL of the MCP server (used as OAuth issuer/resource URL).
LIFELOG_MCP_PUBLIC_URL=http://localhost:8002
# none (local only!) | token (static bearer token) | oauth (for phone AI apps)
LIFELOG_MCP_AUTH_MODE=token
# REPLACE both before `docker compose up` (openssl rand -hex 32): the MCP server refuses to start
# over HTTP when the secret its auth mode needs is empty, a placeholder (`change-me`) or shorter
# than 16 characters. In oauth mode an auth token is optional (leave it empty to disable it).
LIFELOG_MCP_AUTH_TOKEN=change-me
# Password the owner types on the OAuth sign-in page (oauth mode).
LIFELOG_MCP_OWNER_PASSWORD=change-me

# --- Provider credentials (read by LiteLLM / boto3 directly; not prefixed) -----------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION_NAME=us-east-1
