# Lumitrace configuration. Copy to `.env` (never commit `.env`) and fill in.
# Every Lumitrace variable is prefixed LUMITRACE_ and maps to a field in lumitrace/config.py.
# tests/test_config.py fails if a setting is missing here.
# Docker: the image sets LUMITRACE_PROMPTS_DIR, LUMITRACE_LOCAL_ROOT, LUMITRACE_INDEX_PATH and both
# LUMITRACE_GDRIVE_*_FILE paths, and this file overrides them. Delete those lines from a .env used
# with Docker; the relative paths below only work when running from the repository.

# --- General -------------------------------------------------------------------------------
LUMITRACE_LOG_LEVEL=INFO
# IANA timezone used for entry dates and capture times.
LUMITRACE_TIMEZONE=America/Chicago
# Captures before this local hour count as the previous day (0-23).
LUMITRACE_DAY_ROLLOVER_HOUR=4
# Folder holding the versioned AI prompts.
LUMITRACE_PROMPTS_DIR=prompts
# Comma-separated family members. Each gets a sub-section under "Family" in the day file (what
# they ate, where they went, what they did, moments, health, mood, school/work). Empty: none.
# Add each person's relation to you in parentheses and mark yourself with (me), e.g.
# `Sam (me), Maya (wife), Leo (son), Rose (mother)`: the AI then knows who is speaking and who
# "Dad", "Amma" or "my wife" refers to. Relations are free text (wife, son, elder sister, ...).
LUMITRACE_FAMILY=

# --- Prism (recording API) -----------------------------------------------------------------
# Bearer token the Flash (iPhone Shortcuts) sends. Generate with: openssl rand -hex 32
# REPLACE before `docker compose up`: while the token is empty, `change-me` or shorter than 16
# characters, the Prism answers every request (except /health) with 503.
LUMITRACE_API_TOKEN=change-me
LUMITRACE_API_HOST=0.0.0.0
LUMITRACE_API_PORT=8000
LUMITRACE_API_MAX_UPLOAD_MB=200
# Compressed voice-note bitrate (AAC in .m4a). 32 kbps is about 1.5 MB for 6 minutes.
LUMITRACE_AUDIO_BITRATE_KBPS=32
# Longest side of the resized photo copies, and JPEG quality (1-95).
LUMITRACE_PHOTO_MAX_DIMENSION=2048
LUMITRACE_PHOTO_JPEG_QUALITY=85
# Sign-in for the Flash web app (https://<prism address>/flash/). Sign-in is off while the
# username is empty or the password is empty, `change-me` or shorter than 10 characters.
# Sessions are signed with LUMITRACE_API_TOKEN, so that token must be set too. Changing the
# password, the username or the API token signs every browser out.
LUMITRACE_FLASH_USERNAME=
LUMITRACE_FLASH_PASSWORD=change-me
# Days a sign-in lasts before the password is asked again (1-400).
LUMITRACE_FLASH_SESSION_DAYS=90

# --- Storage -------------------------------------------------------------------------------
# local | gdrive
LUMITRACE_STORAGE_BACKEND=local
# Local backend: this folder plays the role of the Drive "Lumitrace" folder.
LUMITRACE_LOCAL_ROOT=data/Lumitrace
# Google Drive backend: OAuth client (Desktop app) JSON from Google Cloud Console, and the token
# file written by `lumitrace-drive-login`. Keep both out of git (secrets/ is ignored).
LUMITRACE_GDRIVE_CLIENT_SECRETS_FILE=secrets/gdrive_client_secret.json
LUMITRACE_GDRIVE_TOKEN_FILE=secrets/gdrive_token.json
# Name of the root folder the app creates in My Drive.
LUMITRACE_GDRIVE_ROOT_FOLDER=Lumitrace

# --- Speech to text ------------------------------------------------------------------------
# litellm (OpenAI, Azure, Groq, ... via LiteLLM) | aws_transcribe | sarvam (Indian languages,
# also mixed with English, plus an English translation) | fake (offline tests)
LUMITRACE_STT_PROVIDER=litellm
# LiteLLM model (litellm provider only).
LUMITRACE_STT_MODEL=openai/gpt-4o-transcribe
# Language code (en, te, ...), or empty to detect it per recording (needed when you speak a mix
# of languages, for example Telugu and English). Sarvam: `te` becomes `te-IN`.
LUMITRACE_STT_LANGUAGE=en
# Comma-separated names, places and brands to help recognition (sarvam only, up to 50 with the
# family names, which are always included), e.g. `Corner Bakery, Riverside Park`.
LUMITRACE_STT_KEYTERMS=
# Amazon Transcribe needs a region and an S3 bucket for the upload.
LUMITRACE_AWS_REGION=us-east-1
LUMITRACE_AWS_TRANSCRIBE_BUCKET=
# Sarvam (https://dashboard.sarvam.ai): API key, model, and the form of the transcript kept in
# the day file: codemix (English words in English, the rest in its own script) | transcribe |
# verbatim | translit (Latin letters).
LUMITRACE_SARVAM_API_KEY=
LUMITRACE_SARVAM_MODEL=saaras:v4
LUMITRACE_SARVAM_MODE=codemix
# Also translate every recording to English (stored under the transcript, used by the AI steps
# and by search). A failed translation only adds a warning.
LUMITRACE_SARVAM_TRANSLATE=true

# --- AI models (LiteLLM model strings, e.g. bedrock/..., openai/..., ollama/...) -----------
# Offline trial without any provider: set all three to `fake` (facts stay empty, the journal is
# the day's text) together with LUMITRACE_STT_PROVIDER=fake and LUMITRACE_EMBEDDING_MODEL=fake.
LUMITRACE_LLM_EXTRACT_FACTS_MODEL=openai/gpt-4o-mini
LUMITRACE_LLM_WRITE_JOURNAL_MODEL=openai/gpt-4o
# Used when the task model fails.
LUMITRACE_LLM_FALLBACK_MODEL=openai/gpt-4o-mini
LUMITRACE_LLM_TIMEOUT_SECONDS=120
LUMITRACE_LLM_MAX_RETRIES=2

# --- Embeddings ----------------------------------------------------------------------------
# LiteLLM embedding model, or "fake" for deterministic offline vectors.
# Changing the model or dimension requires `lumitrace-spectrum rebuild`.
LUMITRACE_EMBEDDING_MODEL=openai/text-embedding-3-small
LUMITRACE_EMBEDDING_DIMENSION=1536

# --- Index / Spectrum (indexer) ------------------------------------------------------------
LUMITRACE_INDEX_PATH=data/index/lumitrace.sqlite
LUMITRACE_INDEXER_HOST=0.0.0.0
LUMITRACE_INDEXER_PORT=8001
LUMITRACE_INDEXER_POLL_INTERVAL_SECONDS=300
# Where the Prism POSTs after each write (in Docker: http://spectrum:8001/nudge).
LUMITRACE_INDEXER_NUDGE_URL=http://localhost:8001/nudge
# How often the index is copied to Drive (_system/index-backup/). 0 disables.
LUMITRACE_INDEXER_BACKUP_INTERVAL_HOURS=24

# --- Lens (MCP server) ---------------------------------------------------------------------
# stdio (local AI apps) | streamable-http (remote / phone AI apps)
LUMITRACE_MCP_TRANSPORT=streamable-http
LUMITRACE_MCP_HOST=0.0.0.0
LUMITRACE_MCP_PORT=8002
LUMITRACE_MCP_PATH=/mcp
# Public HTTPS URL of the Lens (used as OAuth issuer/resource URL).
LUMITRACE_MCP_PUBLIC_URL=http://localhost:8002
# none (local only!) | token (static bearer token) | oauth (for phone AI apps)
LUMITRACE_MCP_AUTH_MODE=token
# REPLACE both before `docker compose up` (openssl rand -hex 32): the Lens refuses to start
# over HTTP when the secret its auth mode needs is empty, a placeholder (`change-me`) or shorter
# than 16 characters. In oauth mode an auth token is optional (leave it empty to disable it).
LUMITRACE_MCP_AUTH_TOKEN=change-me
# Password the owner types on the OAuth sign-in page (oauth mode).
LUMITRACE_MCP_OWNER_PASSWORD=change-me

# --- Provider credentials (read by LiteLLM / boto3 directly; not prefixed) -----------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION_NAME=us-east-1
