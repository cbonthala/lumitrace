# Bookshelf configuration. Copy to `.env` (never commit `.env`) and fill in.
# Every Bookshelf variable is prefixed BOOKSHELF_ and maps to a field in bookshelf/config.py.
# tests/test_config.py fails if a setting is missing here.

# --- General -------------------------------------------------------------------------------
BOOKSHELF_LOG_LEVEL=INFO
# IANA timezone used for entry dates and capture times.
BOOKSHELF_TIMEZONE=America/Chicago
# Captures before this local hour count as the previous day (0-23).
BOOKSHELF_DAY_ROLLOVER_HOUR=4
# Folder holding the versioned AI prompts.
BOOKSHELF_PROMPTS_DIR=prompts

# --- Typewriter (recording API) ------------------------------------------------------------
# Bearer token the Notepad (iPhone Shortcuts) sends. Generate with: openssl rand -hex 32
# REPLACE before `docker compose up`: while the token is empty, `change-me` or shorter than 16
# characters, the Typewriter answers every request (except /health) with 503.
BOOKSHELF_API_TOKEN=change-me
BOOKSHELF_API_HOST=0.0.0.0
BOOKSHELF_API_PORT=8000
BOOKSHELF_API_MAX_UPLOAD_MB=200
# Compressed voice-note bitrate (AAC in .m4a). 32 kbps is about 1.5 MB for 6 minutes.
BOOKSHELF_AUDIO_BITRATE_KBPS=32
# Longest side of the resized photo copies, and JPEG quality (1-95).
BOOKSHELF_PHOTO_MAX_DIMENSION=2048
BOOKSHELF_PHOTO_JPEG_QUALITY=85

# --- Storage -------------------------------------------------------------------------------
# local | gdrive
BOOKSHELF_STORAGE_BACKEND=local
# Local backend: this folder plays the role of the Drive "Bookshelf" folder.
BOOKSHELF_LOCAL_ROOT=data/Bookshelf
# Google Drive backend: OAuth client (Desktop app) JSON from Google Cloud Console, and the token
# file written by `bookshelf-drive-login`. Keep both out of git (secrets/ is ignored).
BOOKSHELF_GDRIVE_CLIENT_SECRETS_FILE=secrets/gdrive_client_secret.json
BOOKSHELF_GDRIVE_TOKEN_FILE=secrets/gdrive_token.json
# Name of the root folder the app creates in My Drive.
BOOKSHELF_GDRIVE_ROOT_FOLDER=Bookshelf

# --- Speech to text ------------------------------------------------------------------------
# litellm (OpenAI, Azure, Groq, ... via LiteLLM) | aws_transcribe | fake (offline tests)
BOOKSHELF_STT_PROVIDER=litellm
BOOKSHELF_STT_MODEL=openai/gpt-4o-transcribe
BOOKSHELF_STT_LANGUAGE=en
# Amazon Transcribe needs a region and an S3 bucket for the upload.
BOOKSHELF_AWS_REGION=us-east-1
BOOKSHELF_AWS_TRANSCRIBE_BUCKET=

# --- AI models (LiteLLM model strings, e.g. bedrock/..., openai/..., ollama/...) ------------
# Offline trial without any provider: set all three to `fake` (facts stay empty, the journal is
# the day's text) together with BOOKSHELF_STT_PROVIDER=fake and BOOKSHELF_EMBEDDING_MODEL=fake.
BOOKSHELF_LLM_EXTRACT_FACTS_MODEL=openai/gpt-4o-mini
BOOKSHELF_LLM_WRITE_JOURNAL_MODEL=openai/gpt-4o
# Used when the task model fails.
BOOKSHELF_LLM_FALLBACK_MODEL=openai/gpt-4o-mini
BOOKSHELF_LLM_TIMEOUT_SECONDS=120
BOOKSHELF_LLM_MAX_RETRIES=2

# --- Embeddings ------------------------------------------------------------------------------
# LiteLLM embedding model, or "fake" for deterministic offline vectors.
# Changing the model or dimension requires `bookshelf-bookmarks rebuild`.
BOOKSHELF_EMBEDDING_MODEL=openai/text-embedding-3-small
BOOKSHELF_EMBEDDING_DIMENSION=1536

# --- Index / Bookmarks (indexer) -----------------------------------------------------------
BOOKSHELF_INDEX_PATH=data/index/bookshelf.sqlite
BOOKSHELF_INDEXER_HOST=0.0.0.0
BOOKSHELF_INDEXER_PORT=8001
BOOKSHELF_INDEXER_POLL_INTERVAL_SECONDS=300
# Where the Typewriter POSTs after each write (in Docker: http://bookmarks:8001/nudge).
BOOKSHELF_INDEXER_NUDGE_URL=http://localhost:8001/nudge
# How often the index is copied to Drive (_system/index-backup/). 0 disables.
BOOKSHELF_INDEXER_BACKUP_INTERVAL_HOURS=24

# --- Reading Lamp (MCP server) -------------------------------------------------------------
# stdio (local AI apps) | streamable-http (remote / phone AI apps)
BOOKSHELF_MCP_TRANSPORT=streamable-http
BOOKSHELF_MCP_HOST=0.0.0.0
BOOKSHELF_MCP_PORT=8002
BOOKSHELF_MCP_PATH=/mcp
# Public HTTPS URL of the Reading Lamp (used as OAuth issuer/resource URL).
BOOKSHELF_MCP_PUBLIC_URL=http://localhost:8002
# none (local only!) | token (static bearer token) | oauth (for phone AI apps)
BOOKSHELF_MCP_AUTH_MODE=token
# REPLACE both before `docker compose up` (openssl rand -hex 32): the Reading Lamp refuses to start
# over HTTP when the secret its auth mode needs is empty, a placeholder (`change-me`) or shorter
# than 16 characters. In oauth mode an auth token is optional (leave it empty to disable it).
BOOKSHELF_MCP_AUTH_TOKEN=change-me
# Password the owner types on the OAuth sign-in page (oauth mode).
BOOKSHELF_MCP_OWNER_PASSWORD=change-me

# --- Provider credentials (read by LiteLLM / boto3 directly; not prefixed) -----------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION_NAME=us-east-1
