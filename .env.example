# Lumen configuration. Copy to `.env` (never commit `.env`) and fill in.
# Every Lumen variable is prefixed LUMEN_ and maps to a field in lumen/config.py.
# tests/test_config.py fails if a setting is missing here.
# Docker: the image sets LUMEN_PROMPTS_DIR, LUMEN_LOCAL_ROOT, LUMEN_INDEX_PATH and both
# LUMEN_GDRIVE_*_FILE paths, and this file overrides them. Delete those lines from a .env used
# with Docker; the relative paths below only work when running from the repository.

# --- General -------------------------------------------------------------------------------
LUMEN_LOG_LEVEL=INFO
# IANA timezone used for entry dates and capture times.
LUMEN_TIMEZONE=America/Chicago
# Captures before this local hour count as the previous day (0-23).
LUMEN_DAY_ROLLOVER_HOUR=4
# Folder holding the versioned AI prompts.
LUMEN_PROMPTS_DIR=prompts
# Comma-separated family members. Each gets a sub-section under "Family" in the day file (what
# they ate, where they went, what they did, moments, health, mood, school/work). Empty: none.
LUMEN_FAMILY=

# --- Prism (recording API) -----------------------------------------------------------------
# Bearer token the Flash (iPhone Shortcuts) sends. Generate with: openssl rand -hex 32
# REPLACE before `docker compose up`: while the token is empty, `change-me` or shorter than 16
# characters, the Prism answers every request (except /health) with 503.
LUMEN_API_TOKEN=change-me
LUMEN_API_HOST=0.0.0.0
LUMEN_API_PORT=8000
LUMEN_API_MAX_UPLOAD_MB=200
# Compressed voice-note bitrate (AAC in .m4a). 32 kbps is about 1.5 MB for 6 minutes.
LUMEN_AUDIO_BITRATE_KBPS=32
# Longest side of the resized photo copies, and JPEG quality (1-95).
LUMEN_PHOTO_MAX_DIMENSION=2048
LUMEN_PHOTO_JPEG_QUALITY=85

# --- Storage -------------------------------------------------------------------------------
# local | gdrive
LUMEN_STORAGE_BACKEND=local
# Local backend: this folder plays the role of the Drive "Lumen" folder.
LUMEN_LOCAL_ROOT=data/Lumen
# Google Drive backend: OAuth client (Desktop app) JSON from Google Cloud Console, and the token
# file written by `lumen-drive-login`. Keep both out of git (secrets/ is ignored).
LUMEN_GDRIVE_CLIENT_SECRETS_FILE=secrets/gdrive_client_secret.json
LUMEN_GDRIVE_TOKEN_FILE=secrets/gdrive_token.json
# Name of the root folder the app creates in My Drive.
LUMEN_GDRIVE_ROOT_FOLDER=Lumen

# --- Speech to text ------------------------------------------------------------------------
# litellm (OpenAI, Azure, Groq, ... via LiteLLM) | aws_transcribe | fake (offline tests)
LUMEN_STT_PROVIDER=litellm
LUMEN_STT_MODEL=openai/gpt-4o-transcribe
# Language code (en, te, ...), or empty to detect it per recording (needed when you speak a mix
# of languages, for example Telugu and English).
LUMEN_STT_LANGUAGE=en
# Amazon Transcribe needs a region and an S3 bucket for the upload.
LUMEN_AWS_REGION=us-east-1
LUMEN_AWS_TRANSCRIBE_BUCKET=

# --- AI models (LiteLLM model strings, e.g. bedrock/..., openai/..., ollama/...) -----------
# Offline trial without any provider: set all three to `fake` (facts stay empty, the journal is
# the day's text) together with LUMEN_STT_PROVIDER=fake and LUMEN_EMBEDDING_MODEL=fake.
LUMEN_LLM_EXTRACT_FACTS_MODEL=openai/gpt-4o-mini
LUMEN_LLM_WRITE_JOURNAL_MODEL=openai/gpt-4o
# Used when the task model fails.
LUMEN_LLM_FALLBACK_MODEL=openai/gpt-4o-mini
LUMEN_LLM_TIMEOUT_SECONDS=120
LUMEN_LLM_MAX_RETRIES=2

# --- Embeddings ----------------------------------------------------------------------------
# LiteLLM embedding model, or "fake" for deterministic offline vectors.
# Changing the model or dimension requires `lumen-spectrum rebuild`.
LUMEN_EMBEDDING_MODEL=openai/text-embedding-3-small
LUMEN_EMBEDDING_DIMENSION=1536

# --- Index / Spectrum (indexer) ------------------------------------------------------------
LUMEN_INDEX_PATH=data/index/lumen.sqlite
LUMEN_INDEXER_HOST=0.0.0.0
LUMEN_INDEXER_PORT=8001
LUMEN_INDEXER_POLL_INTERVAL_SECONDS=300
# Where the Prism POSTs after each write (in Docker: http://spectrum:8001/nudge).
LUMEN_INDEXER_NUDGE_URL=http://localhost:8001/nudge
# How often the index is copied to Drive (_system/index-backup/). 0 disables.
LUMEN_INDEXER_BACKUP_INTERVAL_HOURS=24

# --- Lens (MCP server) ---------------------------------------------------------------------
# stdio (local AI apps) | streamable-http (remote / phone AI apps)
LUMEN_MCP_TRANSPORT=streamable-http
LUMEN_MCP_HOST=0.0.0.0
LUMEN_MCP_PORT=8002
LUMEN_MCP_PATH=/mcp
# Public HTTPS URL of the Lens (used as OAuth issuer/resource URL).
LUMEN_MCP_PUBLIC_URL=http://localhost:8002
# none (local only!) | token (static bearer token) | oauth (for phone AI apps)
LUMEN_MCP_AUTH_MODE=token
# REPLACE both before `docker compose up` (openssl rand -hex 32): the Lens refuses to start
# over HTTP when the secret its auth mode needs is empty, a placeholder (`change-me`) or shorter
# than 16 characters. In oauth mode an auth token is optional (leave it empty to disable it).
LUMEN_MCP_AUTH_TOKEN=change-me
# Password the owner types on the OAuth sign-in page (oauth mode).
LUMEN_MCP_OWNER_PASSWORD=change-me

# --- Provider credentials (read by LiteLLM / boto3 directly; not prefixed) -----------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION_NAME=us-east-1
